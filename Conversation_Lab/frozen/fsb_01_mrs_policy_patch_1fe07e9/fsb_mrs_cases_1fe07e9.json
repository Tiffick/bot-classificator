    {
      "case_id": "FSB-R",
      "coverage_intent": "reflection",
      "frozen_input": {
        "current_user_message": {
          "created_at": "2026-09-14T12:00:00Z",
          "id": "msg_7612c2c70885592faf9f640f4e180a3a",
          "role": "user",
          "sequence": 5,
          "text": "Пробовал просто есть меньше, но после поздней смены сильный голод быстро возвращает меня к прежнему режиму."
        },
        "dialogue_history": {
          "messages": [
            {
              "created_at": "2026-09-14T12:00:00Z",
              "id": "msg_e3a93b01320c554ca13c0af6ff34c1c8",
              "role": "user",
              "sequence": 1,
              "text": "После смены работы привычный режим развалился, и я стал набирать вес."
            },
            {
              "created_at": "2026-09-14T12:00:00Z",
              "id": "msg_737f68c80cd05202a5f63728339dbf8a",
              "role": "system",
              "sequence": 2,
              "text": "Что в этом изменении задевает вас сильнее всего?"
            },
            {
              "created_at": "2026-09-14T12:00:00Z",
              "id": "msg_3966d54dff1e56d083662cca8f0b0922",
              "role": "user",
              "sequence": 3,
              "text": "Мне неловко встречаться с людьми: одежда сидит иначе, и я всё чаще отказываюсь от встреч."
            },
            {
              "created_at": "2026-09-14T12:00:00Z",
              "id": "msg_5551b9ac25e4508a8b32e80ec75c9814",
              "role": "system",
              "sequence": 4,
              "text": "Что вы уже пробовали изменить самостоятельно?"
            }
          ]
        },
        "human_experience": {
