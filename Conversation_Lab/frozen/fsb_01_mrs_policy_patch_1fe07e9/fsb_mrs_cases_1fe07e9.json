    {
      "case_id": "FSB-S",
      "coverage_intent": "stop_exploration",
      "frozen_input": {
        "current_user_message": {
          "created_at": "2026-09-14T12:00:00Z",
          "id": "msg_479988bc7dcc537a9a74165232417c89",
          "role": "user",
          "sequence": 5,
          "text": "Тоже не знаю. Я этого не отслеживал, и больше деталей у меня нет."
        },
        "dialogue_history": {
          "messages": [
            {
              "created_at": "2026-09-14T12:00:00Z",
              "id": "msg_b4c3f021ebd25ee0af90e1ae9a1819e5",
              "role": "user",
              "sequence": 1,
              "text": "По вечерам иногда ем больше, чем собирался."
            },
            {
              "created_at": "2026-09-14T12:00:00Z",
              "id": "msg_62c7a2ab6dbd536b9ddde21a5324220a",
              "role": "system",
              "sequence": 2,
              "text": "Что обычно запускает этот момент вечером?"
            },
            {
              "created_at": "2026-09-14T12:00:00Z",
              "id": "msg_dfb440a08cae5a19adb412167adaa33f",
              "role": "user",
              "sequence": 3,
              "text": "Не знаю, я не замечал, с чего это начинается."
            },
            {
              "created_at": "2026-09-14T12:00:00Z",
              "id": "msg_c1b77bb953665ceba54200af5a1780b1",
              "role": "system",
              "sequence": 4,
              "text": "Может быть, вы замечали, что происходит непосредственно перед желанием поесть?"
            }
          ]
        },
        "human_experience": {
          "enabled": false
        },
