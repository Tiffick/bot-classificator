    {
      "case_id": "FSB-M",
      "coverage_intent": "mechanism_discovery",
      "frozen_input": {
        "current_user_message": {
          "created_at": "2026-09-14T12:00:00Z",
          "id": "msg_b35a9973431553e180aa264a87c614c6",
          "role": "user",
          "sequence": 5,
          "text": "В одном случае я пропустил обед, а в другом нормально поел днём, но перед ужином был тяжёлый разговор."
        },
        "dialogue_history": {
          "messages": [
            {
              "created_at": "2026-09-14T12:00:00Z",
              "id": "msg_224537f39ec857c9b78cdd04ed41bd13",
              "role": "user",
              "sequence": 1,
              "text": "Мне важно снова чувствовать, что я управляю своим вечером, а не еда мной."
            },
            {
              "created_at": "2026-09-14T12:00:00Z",
              "id": "msg_dbdcf0ca964152819f2d69829b0f85d4",
              "role": "system",
              "sequence": 2,
              "text": "Что вы уже пробовали, чтобы вернуть это ощущение управления?"
            },
            {
              "created_at": "2026-09-14T12:00:00Z",
              "id": "msg_1f1e4cc9ab825dd7bb3cad48f0f39252",
              "role": "user",
              "sequence": 3,
              "text": "Пробовал заранее готовить ужин, но в последние два раза всё равно переел."
            },
            {
              "created_at": "2026-09-14T12:00:00Z",
              "id": "msg_1c82762346cb5d95902bd5b355313fc5",
              "role": "system",
              "sequence": 4,
              "text": "Что различалось в обстоятельствах этих двух случаев?"
            }
          ]
        },
        "human_experience": {
          "enabled": false
        },
        "human_model": {
